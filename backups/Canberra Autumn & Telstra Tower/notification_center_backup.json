    styles:
      - Background:=<WindhawkBlur BlurAmount="22" TintColor="#151b28" TintOpacity="0.60" NoiseOpacity="0.04" NoiseDensity="1.0" />
      - BorderBrush=#d97706
      - BorderThickness=1.5
      - CornerRadius=12
  - target: Grid#CalendarCenterGrid
    styles:
      - Background:=<WindhawkBlur BlurAmount="22" TintColor="#151b28" TintOpacity="0.60" NoiseOpacity="0.04" NoiseDensity="1.0" />
      - BorderBrush=#d97706
      - BorderThickness=1.5
      - CornerRadius=12
  - target: Grid#ControlCenterRegion
    styles:
      - Background:=<WindhawkBlur BlurAmount="22" TintColor="#151b28" TintOpacity="0.60" NoiseOpacity="0.04" NoiseDensity="1.0" />
      - BorderBrush=#d97706
      - BorderThickness=1.5
      - CornerRadius=12
  - target: QuickActions.ControlCenter.AccessibleWindow#PageWindow > ContentPresenter > Grid#FullScreenPageRoot
    styles:
      - Background:=<WindhawkBlur BlurAmount="22" TintColor="#151b28" TintOpacity="0.60" NoiseOpacity="0.04" NoiseDensity="1.0" />
      - BorderBrush=#d97706
      - BorderThickness=1.5
      - CornerRadius=12
  - target: ContentPresenter > Grid#FullScreenPageRoot
    styles:
      - Background:=<WindhawkBlur BlurAmount="22" TintColor="#151b28" TintOpacity="0.60" NoiseOpacity="0.04" NoiseDensity="1.0" />
      - BorderBrush=#d97706
      - BorderThickness=1.5
      - CornerRadius=12
  - target: ContentPresenter#PageContent > Grid > Border
    styles:
