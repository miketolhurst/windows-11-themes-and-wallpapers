  - SystemAccentColorLight1=#fc94a3
  - SystemAccentColorLight2=#fdb8c2
  - SystemAccentColorLight3=#fedbe0
  - SystemAccentColorDark1=#c85a6a
  - SystemAccentColorDark2=#96434f
  - SystemAccentColorDark3=#642d35
  - ToggleSwitchFillOn=#fb7185
  - ToggleSwitchFillOnPointerOver=#fc94a3
  - ToggleSwitchFillOnPressed=#c85a6a
  - SliderTrackValueFill=#fb7185
  - SliderTrackValueFillPointerOver=#fc94a3
  - SliderTrackValueFillPressed=#c85a6a
  - SliderThumbBackground=#fb7185
  - SliderThumbBackgroundPointerOver=#fc94a3
  - SliderThumbBackgroundPressed=#c85a6a
