      - BorderBrush=#f472b6
      - BorderThickness=1.5
      - CornerRadius=16
  - target: Grid#CalendarCenterGrid
    styles:
      - Background:=<WindhawkBlur BlurAmount="28" TintColor="#1f1422" TintOpacity="0.55" NoiseOpacity="0.04" NoiseDensity="1.0" />
      - BorderBrush=#f472b6
      - BorderThickness=1.5
      - CornerRadius=16
  - target: Grid#ControlCenterRegion
    styles:
      - Background:=<WindhawkBlur BlurAmount="28" TintColor="#1f1422" TintOpacity="0.55" NoiseOpacity="0.04" NoiseDensity="1.0" />
      - BorderBrush=#f472b6
      - BorderThickness=1.5
      - CornerRadius=16
