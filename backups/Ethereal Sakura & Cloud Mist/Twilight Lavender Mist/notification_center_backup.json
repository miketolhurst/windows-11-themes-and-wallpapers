    styles:
      - Background:=<WindhawkBlur BlurAmount="5" TintColor="#281834" TintOpacity="0.55" NoiseOpacity="0.05" NoiseDensity="1.0" />
      - BorderBrush=#c084fc
      - BorderThickness=2
      - CornerRadius=18
  - target: Grid#CalendarCenterGrid
    styles:
      - Background:=<WindhawkBlur BlurAmount="5" TintColor="#281834" TintOpacity="0.55" NoiseOpacity="0.05" NoiseDensity="1.0" />
      - BorderBrush=#c084fc
      - BorderThickness=2
      - CornerRadius=18
  - target: Grid#ControlCenterRegion
    styles:
      - Background:=<WindhawkBlur BlurAmount="5" TintColor="#281834" TintOpacity="0.55" NoiseOpacity="0.05" NoiseDensity="1.0" />
      - BorderBrush=#c084fc
      - BorderThickness=2
      - CornerRadius=18
  - target: QuickActions.ControlCenter.AccessibleWindow#PageWindow > ContentPresenter > Grid#FullScreenPageRoot
    styles:
      - Background:=<WindhawkBlur BlurAmount="5" TintColor="#281834" TintOpacity="0.55" NoiseOpacity="0.05" NoiseDensity="1.0" />
      - BorderBrush=#c084fc
      - BorderThickness=2
      - CornerRadius=18
  - target: ContentPresenter > Grid#FullScreenPageRoot
    styles:
      - Background:=<WindhawkBlur BlurAmount="5" TintColor="#281834" TintOpacity="0.55" NoiseOpacity="0.05" NoiseDensity="1.0" />
      - BorderBrush=#c084fc
      - BorderThickness=2
      - CornerRadius=18
