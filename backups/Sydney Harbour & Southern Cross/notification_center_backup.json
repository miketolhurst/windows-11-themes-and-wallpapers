      - BorderBrush=#d4af37
      - BorderThickness=1.5
      - CornerRadius=10
  - target: Grid#CalendarCenterGrid
    styles:
      - Background:=<WindhawkBlur BlurAmount="26" TintColor="#061226" TintOpacity="0.65" NoiseOpacity="0.04" NoiseDensity="1.0" />
      - BorderBrush=#d4af37
      - BorderThickness=1.5
      - CornerRadius=10
  - target: Grid#ControlCenterRegion
    styles:
