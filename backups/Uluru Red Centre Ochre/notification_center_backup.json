  - SystemAccentColorLight1=#d17048
  - SystemAccentColorLight2=#e0a085
  - SystemAccentColorLight3=#efcfc2
  - SystemAccentColorDark1=#9b3409
  - SystemAccentColorDark2=#742707
  - SystemAccentColorDark3=#4d1a04
  - ToggleSwitchFillOn=#c2410c
  - ToggleSwitchFillOnPointerOver=#d17048
  - ToggleSwitchFillOnPressed=#9b3409
  - SliderTrackValueFill=#c2410c
  - SliderTrackValueFillPointerOver=#d17048
  - SliderTrackValueFillPressed=#9b3409
  - SliderThumbBackground=#c2410c
  - SliderThumbBackgroundPointerOver=#d17048
  - SliderThumbBackgroundPressed=#9b3409
